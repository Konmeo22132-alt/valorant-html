[Unit]
Description=VAL-STRIKE multiplayer and account server
After=network.target

[Service]
Type=simple
User=valstrike
Group=valstrike
WorkingDirectory=/opt/val-strike/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8455
Environment=COOKIE_SECURE=1
Environment=TRUST_PROXY=1
Environment=DB_PATH=/var/lib/val-strike/val-strike.sqlite
ExecStart=/usr/bin/node --max-old-space-size=256 server/server.cjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/val-strike
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
